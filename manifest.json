{
  "manifest_version": 3,
  "name": "TYAgrey Hitter",
  "version": "1.1",
  "description": "TYAgrey Hitter - Stripe Checkout/Invoice Auto Hitter",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "proxy",
    "webRequest",
    "webRequestAuthProvider",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "offscreen",
    "downloads",
    "clipboardWrite",
    "clipboardRead",
    "tabs",
    "webNavigation",
    "alarms",
    "notifications",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "script/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["script/content.js"],
      "css": ["design/styles.css","design/tya-overlay.css"],
      "run_at": "document_end",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.hcaptcha.com/*",
        "*://hcaptcha.com/*",
        "*://newassets.hcaptcha.com/*"
      ],
      "js": ["script/hcaptcha.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["script/anti-detect.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.google.com/recaptcha/*",
        "*://*.recaptcha.net/*",
        "*://*.gstatic.com/recaptcha/*"
      ],
      "js": ["script/recaptcha-solver.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["script/auto-clicker.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "script/inject.js",
        "script/storage.js",
        "script/autofill.js",
        "script/proxyhandler.js",
        "script/anti-detect.js",
        "script/recaptcha-solver.js",
        "script/auto-clicker.js",
        "design/styles.css",
        "sounds/hit.wav",
        "sounds/music.mp3",
        "icons/icon128.png"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "TYAgrey Hitter - Open Dashboard"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}




